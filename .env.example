# Copy to .env and edit. Never commit .env.
# Every variable has a working default: the gateway boots with no .env at all.

NODE_ENV=development
HOST=127.0.0.1
PORT=8787
LOG_LEVEL=info

# Answer from an in-process canned upstream instead of contacting a provider;
# only the network call is replaced. On boot a demo API key is written to
# data/DEMO_API_KEY.txt. Empty, 0 and false all mean off.
MOCK_UPSTREAM=

# JSON file holding the upstream credential. TokenManager reads it before every
# call and refreshes it near expiry. Mock mode writes a placeholder if missing.
CREDENTIALS_PATH=./data/credentials.json

ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_OAUTH_TOKEN_URL=https://console.anthropic.com/v1/oauth/token
CLAUDE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Reported upstream in the User-Agent as `ai-api-bridge/<version>`: the gateway
# identifies itself. Keep it in step with package.json's version.
GATEWAY_VERSION=0.1.0

DATABASE_PATH=./data/gateway.db

DEFAULT_MAX_TOKENS=4096

# CORS: comma-separated origins; empty = no cross-origin request allowed.
ALLOWED_ORIGINS=

# Admin token guarding /admin/* (separate from the client API keys). Empty or
# shorter than 16 characters, and every /admin/* route answers 404.
ADMIN_TOKEN=
